# =============================================================================
#  Plantilla de configuración del backend PEDIDOS.
#  Copia este archivo como ".env" y reemplaza los valores <...> por los reales.
#  El .env real NO se versiona (está en .gitignore) porque contiene secretos.
# =============================================================================

# Servidor
PORT=3000
NODE_ENV=production

# JWT — secreto para firmar los tokens de sesión (usar una cadena larga aleatoria)
JWT_SECRET=<secreto-aleatorio-largo>

# Base de datos SQL Server
DB_SERVER=192.168.2.244
DB_USER=sa
DB_PASSWORD=<password-sql>
DB_PORT=1433

# Nombres de las bases de datos
DB_NAME=SkyPagos
PEDIDOS_DB_NAME=Pedidos
SAP_DB_NAME=RBOSKY3
RUTA_DB_NAME=Ruta

# Seguridad
BCRYPT_ROUNDS=10
# Duración de la sesión (formato jsonwebtoken: "24h", "7d"...). NO uses número
# pelado: "86400" se interpreta como milisegundos, no segundos.
SESSION_TIMEOUT=24h

# Control de dispositivos por ID de servicio.
# REQUIRE_DEVICE_ID=true obliga a que todo login traiga id_servicio y el
# dispositivo esté ACTIVO. Déjalo en false durante el despliegue inicial y
# ponlo en true cuando todos los teléfonos tengan el APK nuevo.
REQUIRE_DEVICE_ID=false

# Soporte TI — códigos de usuarios designados, separados por coma (ej:
# SOPORTE_USUARIOS=SKV100,SKV200). Son usuarios normales que inician sesión con
# sus credenciales de siempre; al entrar reciben el rol "soporte" para
# administrar la activación/desactivación de dispositivos. Aquí NO van
# contraseñas ni cuentas especiales.
SOPORTE_USUARIOS=<codigos-separados-por-coma>

# Rate limiting (actualmente hardcodeado en server.js; documentado aquí)
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=5

# Google Maps Geocoding
GOOGLE_MAPS_API_KEY=<api-key-google-maps>
